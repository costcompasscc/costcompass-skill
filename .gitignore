# CLI (Python + uv) build, cache, and venv artifacts — never committed.
# Scoped to client/ so this tree is self-contained regardless of global excludes.
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Test / lint / coverage caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Packaging output
dist/
build/

# Local tool config is per-developer and lives in ~/.config/costcompass/,
# but guard against an accidental in-tree copy holding an API key.
config.toml
.env

# Formatter tooling (prettier). package.json/package-lock.json ARE committed —
# only the installed tree is not.
node_modules/
